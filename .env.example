# Studio14 — Environment Variables Configuration
# Copy this file to .env.local to connect a live webhook or email provider for POST /api/contact

# Option 1: Webhook Integration (Make, Zapier, n8n, Slack, or custom CRM endpoint)
# CONTACT_WEBHOOK_URL="https://hook.eu1.make.com/your-webhook-id"

# Option 2: Resend Email API Integration
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# CONTACT_RECEIVER_EMAIL="hello@studio14.creative"

